{
	"name": "markpad",
	"version": "2.8.3",
	"description": "Light as Notepad, elegant as Markdown.",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"test": "node --test --import tsx 'scripts/*.test.ts'",
		"test:vitest": "vitest run",
		"test:frontmatter": "node --test --import tsx scripts/frontMatter.test.ts scripts/frontMatterProseBlock.test.ts",
		"test:workflows": "node --test --import tsx scripts/exportHtml.test.ts scripts/exportOpenPrompt.test.ts scripts/editorToolbar.test.ts scripts/titlebarToolbar.test.ts",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"build:test-bundle": "node scripts/build-test-bundle.mjs",
		"tauri": "tauri",
		"release": "node scripts/release.mjs"
	},
	"license": "BSD-3-Clause",
	"dependencies": {
		"@excalidraw/utils": "^0.1.3-test32",
		"@hpcc-js/wasm-graphviz": "^1.21.0",
		"@tauri-apps/api": "^2",
		"@tauri-apps/plugin-dialog": "^2.5.0",
		"@tauri-apps/plugin-opener": "^2",
		"@tauri-apps/plugin-process": "^2.3.1",
		"@tauri-apps/plugin-updater": "^2.10.1",
		"@viz-js/viz": "^3.24.0",
		"@zumer/snapdom": "^2.12.8",
		"bpmn-js": "^18.12.0",
		"dompurify": "3.4.16",
		"highlight.js": "^11.11.2",
		"highlightjs-svelte": "^1.0.6",
		"katex": "^0.18.4",
		"mermaid": "^11.16.0",
		"monaco-editor": "^0.55.1",
		"monaco-vim": "^0.4.4",
		"nomnoml": "^1.7.0",
		"pako": "^2.1.0",
		"vega": "^6.2.0",
		"vega-embed": "^7.1.0",
		"vega-lite": "^6.4.2",
		"yaml": "^2.9.0"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^5.1.1",
		"@tauri-apps/cli": "^2.11.4",
		"@types/node": "^26.2.0",
		"@types/pako": "^2.0.4",
		"happy-dom": "^20.10.4",
		"jsdom": "^30.0.1",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.5",
		"tsx": "^4.23.12",
		"typescript": "^5.9.3",
		"vite": "^6.4.3",
		"vitest": "^4.1.10"
	},
	"overrides": {
		"cookie": "0.7.2",
		"dompurify": "3.4.16"
	}
}
